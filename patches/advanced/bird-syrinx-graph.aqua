patch gain=0.40 soft_clip=true

param path=/bird/left/pressure default=.84 min=0 max=1.5 step=.001 rate=audio
param path=/bird/right/pressure default=.72 min=0 max=1.5 step=.001 rate=audio
param path=/bird/left/opening default=.20 min=0 max=1 step=.001 rate=audio
param path=/bird/right/opening default=.18 min=0 max=1 step=.001 rate=audio
param path=/bird/left/tension default=.46 min=0 max=1 step=.001 rate=audio
param path=/bird/right/tension default=.52 min=0 max=1 step=.001 rate=audio
param path=/bird/beak/opening default=.92 min=0 max=1.5 step=.001

curve name=left_air path=/bird/left/pressure points=0:.04,.025:.92,.22:.78,.54:.88,.82:.18 mode=blend depth=.95 rate=audio
curve name=right_air path=/bird/right/pressure points=0:.02,.035:.75,.18:.82,.48:.62,.82:.12 mode=blend depth=.95 rate=audio
curve name=left_labium_gate path=/bird/left/opening points=0:.01,.03:.21,.62:.18,.82:.02 mode=blend depth=.9 rate=audio
curve name=right_labium_gate path=/bird/right/opening points=0:.01,.035:.18,.54:.15,.82:.02 mode=blend depth=.9 rate=audio
curve name=beak_gate path=/bird/beak/opening points=0:.22,.04:.92,.44:1.08,.82:.35 mode=blend depth=.75
gesture name=two_sided_song curves=left_air,right_air,left_labium_gate,right_labium_gate,beak_gate depth=1

area_curve name=left_bronchus_curve length_cm=3.6 diameters=.18,.24,.31,.38
area_curve name=right_bronchus_curve length_cm=3.4 diameters=.17,.23,.30,.36
area_curve name=trachea_curve length_cm=8.2 diameters=.36,.46,.54,.48,.38

path name=left_bronchus area_curve=left_bronchus_curve loss=.996 loss_model=wall
path name=right_bronchus area_curve=right_bronchus_curve loss=.996 loss_model=wall
path name=trachea area_curve=trachea_curve loss=.997 loss_model=viscous

source_port name=left_labium path=left_bronchus kind=syrinx law=one_mass position=0 pressure=@/bird/left/pressure tension=@/bird/left/tension opening=@/bird/left/opening noise=.018 mass=.24 damping=.11 stiffness=.032 saturation=.82 reservoir_pressure=1 downstream_pressure=.02 load_coupling=.46 rest_opening=.018 drive=1.22
source_port name=right_labium path=right_bronchus kind=syrinx law=one_mass position=0 pressure=@/bird/right/pressure tension=@/bird/right/tension opening=@/bird/right/opening noise=.016 balance=.94 mass=.25 damping=.12 stiffness=.036 saturation=.84 reservoir_pressure=1 downstream_pressure=.02 load_coupling=.46 rest_opening=.018 drive=1.18

terminal name=left_merge path=left_bronchus position=1 kind=junction area_scale=1
terminal name=right_merge path=right_bronchus position=1 kind=junction area_scale=1
terminal name=trachea_base path=trachea position=0 kind=junction area_scale=1
connect name=syrinx_merge terminals=left_merge,right_merge,trachea_base law=area_scatter coupling=1

radiation_port name=beak path=trachea kind=beak model=beak position=1 opening=@/bird/beak/opening reflection=-.72 loss=.98
wave_clock name=bird_clock strategy=linear max_delay=2048 smoothing_ms=2
acoustic_network name=bird_syrinx_graph path=trachea wave_clock=bird_clock sources=left_labium,right_labium radiation=beak terminals=left_merge,right_merge,trachea_base connections=syrinx_merge
acoustic network=bird_syrinx_graph freq=980 gain=.24 sustain=.82 decay=.06
