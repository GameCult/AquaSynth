# electro-drop-demo
# Family: advanced
# Source: AquaSynth song-swarm synthesis demo
# Notes: Electro/complextro demo using song-curriculum sugar, layered bass chops, build tension, and a drop.

patch
    gain=0.68
    duration=64
    soft_clip=true

meter bpm=128 beats=4

# Section authority: intro -> build -> drop -> break -> build2 -> final_drop.
song_form name=electro unit=bar
    sections=intro:0-4:.35,build:4-8:.85,drop:8-16:1,break:16-20:.55,build2:20-24:.85,final_drop:24-32:1
    energy=0:.22,4:.55,7.5:.92,8:1,16:.42,20:.62,23.5:.95,24:1,32:.18

# 808-derived drum authority: library shapes, then retriggered, driven, folded, and animated.
sequence name=kick_808 pattern=x...x...x...x... step=.117187 high=1.18 low=0
sequence name=kick_ghost pattern=..x.....x.....x. step=.117187 high=.30 low=0
sequence name=snare_808 pattern=....x.......x... step=.117187 high=.72 low=0
sequence name=clap_808 pattern=....x.......x... step=.117187 high=.42 low=0
sequence name=hat_808 pattern=x.x.x.xx.x.x.xxx. step=.117187 high=.22 low=.022
sequence name=hat_open pattern=..x.....x...x... step=.117187 high=.16 low=0
sequence name=perc_skip pattern=...x......x...x. step=.117187 high=.18 low=0

mod name=drum_crush
    wave=sample_hold
    hz=16
    gain=.018
    drive=.28
    fold=.18
    noise=.045
    hpf=.025

mod name=hat_sizzle
    wave=square
    hz=8
    noise=.055
    hpf=.045
    lpf=-.025

bass_response name=sub
    root=55
    progression=0,5,3,4
    pattern=x.......x...x...
    step=.117187
    scene=0:.04,8:.10,16:.18,24:.14,32:.03,40:.14,56:.20,64:.08
    wave=triangle
    lpf=.30
    fm=1.9
    fmi=.24

chords name=drop_prog root=110 scale=minor progression=0,5,3,4 voicing=0,2,4 paths=/chords/drop/root,/chords/drop/third,/chords/drop/fifth step=bar
scale name=hook path=/seq/hook/freq root=440 scale=minor degrees=0,2,4,2,0,-2,0,4 step=.46875

sequence name=hook_phrase pattern=x...x.......x...x.....x....... step=.117187 high=.26 low=0
sequence name=hook_answer pattern=........x.......x.......x...x... step=.117187 high=.16 low=0
sequence name=hook_breath pattern=x...............x............... step=.117187 high=.055 low=0
sequence name=bass_a pattern=x.......x....... step=.117187 high=.32 low=0
sequence name=bass_b pattern=....x.......x... step=.117187 high=.22 low=0
sequence name=bass_c pattern=..........x...x. step=.117187 high=.18 low=0
sequence name=stab_gate pattern=......x......... step=.117187 high=.22 low=0
sequence name=fill_gate pattern=..............x. step=.117187 high=.18 low=0

mix name=lead points=0:.01,8:.025,14:.06,16:.08,24:.06,32:.015,40:.055,48:.10,56:.12,64:.025
mix name=pad points=0:.025,8:.06,15:.12,16:.025,28:.03,32:.10,40:.035,48:.07,64:.025
mix name=air points=0:.006,8:.014,15:.04,16:.004,32:.025,40:.01,47:.05,48:.006,64:.004
section_rise name=riser start=8 peak=15.5 end=16 low=0 high=.25
section_rise name=second_riser start=40 peak=47.5 end=48 low=0 high=.31

additive_wash name=wash root=@/chords/drop/root partials=1:.06,2:.025,3:.014,5:.008 scene=0:.02,8:.06,15:.10,16:.02,32:.08,40:.035,48:.08,64:.02 lpf=.54
layer name=halo engine=pad gain=@/mix/pad/gain env=rl rates=.55,.85,1.25,1.8 levels=.9,.95,.78,0 gate=4
spectrum layer=halo root=110 freq=220 spread=.009 pad_mode=bandwidth pad_bandwidth=560 pad_bwscale=2 partials=1:.07,1.5:.03,2:.022,3:.012

texture name=air_wash role=air gain=@/mix/air/gain sustain=64
texture name=codec_spray role=codec pattern=..x...x...x..x.. step=.117187 gain=.006 sustain=64

# 808 library voices, stretched and dirtied for the drop.
voice name=eight08_kick_body wave=sine freq=58 gain=@/seq/kick_808 trigger=.117187 attack=.001 sustain=.045 decay=.42 sustain_level=.606 pitch_ramp=-3.8 min_freq=32 lpf=.85 drive=.42 fold=.12
voice name=eight08_kick_ghost wave=sine freq=52 gain=@/seq/kick_ghost trigger=.117187 attack=.001 sustain=.03 decay=.30 sustain_level=.42 pitch_ramp=-2.4 min_freq=31 lpf=.70 drive=.30 fold=.08
voice name=eight08_kick_click wave=noise freq=2600 gain=@/seq/kick_808 trigger=.117187 attack=.001 sustain=.006 decay=.024 noise=.92 hpf=.72 lpf=.24 bpf=.50 bpf_q=3.2 drive=.42 fold=.22
voice name=eight08_snare_body wave=sine freq=180 gain=@/seq/snare_808 trigger=.117187 attack=.001 sustain=.02 decay=.12 pitch_ramp=-1.2 lpf=.52 drive=.28 fold=.08
voice name=eight08_snare_noise wave=noise freq=140 gain=@/seq/snare_808 trigger=.117187 attack=.001 sustain=.035 decay=.20 noise=.85 hpf=.45 lpf=.55 bpf=.38 bpf_q=2.4 drive=.55 fold=.24
voice name=eight08_clap_one wave=noise freq=1800 gain=@/seq/clap_808 trigger=.117187 attack=.001 sustain=.018 decay=.11 noise=.95 hpf=.55 lpf=.42 phaser=.004 drive=.38 fold=.16
voice name=eight08_clap_two wave=noise freq=2200 gain=@/seq/clap_808 trigger=.117187 attack=.006 sustain=.022 decay=.13 noise=.95 hpf=.58 lpf=.38 phaser=.008 drive=.42 fold=.18
voice name=eight08_clap_three wave=noise freq=2600 gain=@/seq/clap_808 trigger=.117187 attack=.012 sustain=.028 decay=.15 noise=.95 hpf=.62 lpf=.34 phaser=.012 drive=.46 fold=.20
voice name=eight08_hat_noise wave=noise freq=9000 gain=@/seq/hat_808 trigger=.117187 attack=.001 sustain=.006 decay=.055 noise=1 hpf=.90 lpf=.24 drive=.30 fold=.20
voice name=eight08_hat_metal wave=square freq=6800 gain=@/seq/hat_808 trigger=.117187 attack=.001 sustain=.005 decay=.04 hpf=.90 lpf=.24 duty=.42 drive=.24 fold=.30
voice name=eight08_open_hat wave=noise freq=9800 gain=@/seq/hat_open trigger=.117187 attack=.001 sustain=.018 decay=.18 noise=1 hpf=.88 lpf=.28 drive=.34 fold=.22
voice name=eight08_perc_skip wave=square freq=540 gain=@/seq/perc_skip trigger=.117187 attack=.001 sustain=.025 decay=.14 duty=.42 hpf=.18 lpf=.72 drive=.34 fold=.26

voice name=hook_front wave=triangle freq=@/seq/hook/freq gain=@/seq/hook_phrase attack=.004 sustain=.11 decay=.24 lpf=.64 bpf=.44 bpf_q=1.8 fm=.9 fmi=.07 vibrato=.003 vibrato_hz=5.2 formants=620:90:.34,1160:150:.22,2300:320:.10 formant_mix=.16 drive=.04
voice name=hook_answer wave=sine freq=@/seq/hook/freq gain=@/seq/hook_answer attack=.006 sustain=.08 decay=.18 hpf=.04 lpf=.58 bpf=.38 bpf_q=1.4 fm=1.4 fmi=.05 vibrato=.002 vibrato_hz=6.1 formants=520:100:.22,1320:180:.28 formant_mix=.12
voice name=hook_breath wave=noise freq=7600 gain=@/seq/hook_breath attack=.006 sustain=.06 decay=.16 hpf=.72 lpf=.18 bpf=.64 bpf_q=2.4

# Complextro cut-ups: separate timbres take turns instead of one polite bass patch.
voice name=bass_chop_a wave=saw freq=@/chords/drop/root gain=@/seq/bass_a sustain=64 decay=.10 lpf=.24 fm=3.2 fmi=.65 drive=.22 fold=.08
voice name=bass_chop_b wave=square freq=@/chords/drop/fifth gain=@/seq/bass_b sustain=64 decay=.08 lpf=.32 hpf=.05 fm=5.4 fmi=.46 duty=.31 drive=.18
voice name=bass_chop_c wave=triangle freq=@/chords/drop/third gain=@/seq/bass_c sustain=64 decay=.12 bpf=.48 bpf_q=2.8 fm=1.6 fmi=.72 drive=.14
voice name=stab wave=saw freq=@/chords/drop/fifth gain=@/seq/stab_gate attack=.001 sustain=.05 decay=.16 lpf=.62 hpf=.08 fm=2.2 fmi=.24 drive=.2
voice name=turnaround_fill wave=square freq=@/seq/hook/freq gain=@/seq/fill_gate attack=.001 sustain=.035 decay=.09 hpf=.3 lpf=.72 duty=.42 fm=7.2 fmi=.38

voice name=drop_weight wave=sine freq=55 gain=@/form/electro/drop attack=.001 sustain=.12 decay=.28 pitch_ramp=-.8 lpf=.34 drive=.08
voice name=final_drop_weight wave=triangle freq=55 gain=@/form/electro/final_drop attack=.001 sustain=.16 decay=.34 lpf=.38 fm=1.1 fmi=.18 drive=.12
voice name=build_riser wave=saw freq=220 gain=@/mix/riser/gain attack=.01 sustain=64 decay=.1 pitch_ramp=2.4 lpf=.72 hpf=.24 fm=1.2 fmi=.18
voice name=second_build_riser wave=saw freq=165 gain=@/mix/second_riser/gain attack=.01 sustain=64 decay=.1 pitch_ramp=2.9 lpf=.78 hpf=.22 fm=1.6 fmi=.22
voice name=break_pluck wave=triangle freq=@/chords/drop/third gain=@/form/electro/break attack=.004 sustain=.09 decay=.34 lpf=.44 hpf=.02 fm=.8 fmi=.12
