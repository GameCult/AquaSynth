  <div class="sqs-html-content" data-sqsp-text-block-content><p class="" style="white-space:pre-wrap;"><a href="/home">Home</a></p><p class="" style="white-space:pre-wrap;"><a href="/about"><span class="sqsrte-text-color--custom" style="color: #777777">About</span></a></p><p class="" style="white-space:pre-wrap;"><a href="/legacy"><span class="sqsrte-text-color--custom" style="color: #777777">Legacy</span></a></p><p class="" style="white-space:pre-wrap;"><a href="/demos"><span class="sqsrte-text-color--custom" style="color: #777777">Demos</span></a></p><p class="" style="white-space:pre-wrap;"><a href="/people"><span class="sqsrte-text-color--custom" style="color: #777777">People</span></a></p><p class="" style="white-space:pre-wrap;"><a href="/groups"><span class="sqsrte-text-color--custom" style="color: #777777">Groups</span></a></p><p class="" style="white-space:pre-wrap;"><a href="/seminarseries"><span class="sqsrte-text-color--custom" style="color: #777777">Seminars</span></a></p><p class="" style="white-space:pre-wrap;"><a href="/news"><span class="sqsrte-text-color--custom" style="color: #777777">News</span></a></p></div>


  
